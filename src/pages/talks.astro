---
import Base from '../layouts/Base.astro';
import TalkItem from '../components/TalkItem.astro';
import { talkGroups, talksTitle, site, activeMarks, markLabel, podcast } from '../lib/data';
import recordedTalks from '../data/recorded-talks.json';
const talks = talkGroups();
const youtubeId = (url: string) => url.match(/[?&]v=([^&]+)/)?.[1] ?? null;
---
<Base title={talksTitle} description={`${talksTitle} by Dr. Tomaz Amorim.`} path="/talks/" nav="talks">
  <section class="row">
    <div class="pl"></div>
    <div class="bed">
      <h1 class="title">{talksTitle}</h1>
      {activeMarks(site.menu_tbc.talks).map((m) => <p class="label"><span class="tbc">{markLabel(m)}</span></p>)}
    </div>
    <div class="pr"></div>
  </section>
  <section class="row sp-m">
    <div class="pl"></div>
    <div class="bed">
      <ul class="items talk-list">{talks.map((g) => <TalkItem t={g.main} also={g.also} />)}</ul>
    </div>
    <div class="pr"></div>
  </section>
  <section class="row sp-m" aria-labelledby="recorded-talks">
    <div class="pl"></div>
    <div class="bed">
      <h2 class="group" id="recorded-talks">Recorded talks and events</h2>
      <ul class="items recorded-list">
        {recordedTalks.map((t) => {
          const id = youtubeId(t.url);
          return <li class="item recorded-item">
            {id && <a class="recording-thumb" href={t.url} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${t.title} on YouTube`}>
              <img src={`https://i.ytimg.com/vi/${id}/mqdefault.jpg`} alt="" loading="lazy" width="160" height="90" />
              <span class="play-mark" aria-hidden="true">▶</span>
            </a>}
            <div class="recording-copy">
              <strong class="recording-title"><a href={t.url} target="_blank" rel="noopener noreferrer">{t.title}</a></strong>
              {t.commentary && <span class="recording-meta commentary" lang="pt">{t.commentary}</span>}
              <span class="recording-meta">{t.event}</span>
              <span class="recording-meta">{t.published} · {t.duration}</span>
            </div>
          </li>;
        })}
      </ul>
    </div>
    <div class="pr"></div>
  </section>
  {podcast.episodes.length > 0 && <section class="row sp-m" aria-labelledby="podcasts">
    <div class="pl"></div>
    <div class="bed">
      <h2 class="group" id="podcasts">Podcasts</h2>
      <ul class="items podcast-list">
        {podcast.episodes.map((e) => {
          return <li class="item podcast-item">
            <div class="podcast-copy">
              <strong class="podcast-title">{e.title}</strong>
              <span class="podcast-meta">{e.date} · Spotify</span>
              <p>{e.description}</p>
              <a class="podcast-link" href={e.url} target="_blank" rel="noopener noreferrer">Open on Spotify ↗</a>
            </div>
            <a class="podcast-cover" href={e.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${e.title} on Spotify`}>
              <img src={e.cover} alt={e.cover_alt} loading="lazy" width="180" height="180">
            </a>
          </li>;
        })}
      </ul>
    </div>
    <div class="pr"></div>
  </section>}
</Base>
