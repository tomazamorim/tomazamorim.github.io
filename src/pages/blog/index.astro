---
import Base from '../../layouts/Base.astro';
// Textos de Tomaz publicados em outros blogs: cartão com resumo e link (o texto não é reproduzido aqui).
const elsewhere = [
  {
    title: 'The Tapirapé Masks: Infrastructures of Memory and Diplomacy',
    byline: 'Tomaz Amorim in conversation with Ana Coutinho',
    venue: 'TRAFO – Blog for Transregional Research',
    date: '5 Nov 2026',
    url: 'https://trafo.hypotheses.org/70182',
    doi: '10.58079/172m1',
    kind: 'Interview',
    summary: 'After the visit of the Apyãwa-Tapirapé ritual specialists Paroo’i and Makato Koxamare’i Tapirapé to the research group in Bochum in March 2026, Tomaz Amorim talks with the anthropologist Ana Coutinho about the cara-grande (Ype) masks of the Tapirapé. The conversation follows the masks from their ritual role as the “face” of the enemy to the masks made specifically for sale, which the Tapirapé turned into instruments of alliance and diplomacy, and from there to European museums and to the “expulsion by suffocation” that soya plantations impose on the Tapirapé territory.',
  },
];
---

<Base
  title="Extractive Aesthetics"
  description="A research blog on the subterranean relations between literature, infrastructure, and extraction in Latin America."
  path="/blog/"
  nav="blog"
>
  <section class="row blog-intro">
    <div class="pl"></div>
    <div class="bed">
      <p class="sc blog-kicker">Research blog</p>
      <h1 class="title">Extractive Aesthetics</h1>
      <p class="lead blog-subtitle">Material and Symbolic Infrastructures in Latin American Literature</p>
      <p class="blog-platform">This research blog is being developed for <a href="https://hypotheses.org/">Hypotheses</a>, an academic blogging platform for the humanities and social sciences. This page will introduce the project and, as the blog takes shape, point readers to its publications.</p>
    </div>
    <div class="pr"></div>
  </section>

  <section class="row blog-section">
    <div class="pl"></div>
    <div class="bed">
      <h2 class="cv-h">The project</h2>
      <p><em>Extractive Aesthetics</em> explores the subterranean relations between literature, infrastructure, and extraction in Latin America. How have the transformation of land into a resource, the circulation of commodities and people, and the infrastructures that sustain them shaped not only territories and economies, but also the ways we perceive and imagine the world?</p>
      <p>Rather than treating literature simply as a record of these processes, the project reads it as a space where they take form and become contested. In dialogue with earlier and contemporary writing, Brazilian modernism offers a vantage point from which to examine the extractive view: promises of progress and their material costs, the coexistence of different temporalities, and the aesthetic forms through which histories of extraction enter the text. From the Global South and its peripheral position in relation to modernity, literature can reproduce extractive relations, but it can also expose their hidden connections and unsettle the worlds they produce.</p>
    </div>
    <div class="pr"></div>
  </section>

  <section class="row blog-section">
    <div class="pl"></div>
    <div class="bed">
      <h2 class="cv-h">A research diary, and more</h2>
      <p>The blog will bring together a research diary, essays, reading notes, theoretical reflections, archival discoveries, historical documents, photographs, maps, and other visual materials. It will also feature conversations with researchers, writers, artists, activists, Indigenous and Quilombola thinkers, and people involved in struggles for land, territorial rights, and environmental protection.</p>
      <p>These conversations are not meant simply to illustrate an argument. They can question its assumptions and bring different forms of knowledge into the research. A central concern is the tension between seeing land as a reserve of resources and understanding territory as a field of historical, social, and more-than-human relations. Alongside the material infrastructures of extraction, the blog will attend to the symbolic operations that make them seem natural, inevitable, or desirable—and to the ways communities resist these relations and imagine other ways of inhabiting the territory.</p>
      <p>The project speaks to readers of Latin American literature, literary and cultural theory, modernism, infrastructure studies, and political ecology, as well as to writers, artists, activists, and others concerned with environmental and territorial struggles in the region and their planetary connections.</p>
    </div>
    <div class="pr"></div>
  </section>

  {elsewhere.length > 0 && <section class="row blog-section blog-elsewhere" aria-labelledby="elsewhere-title">
    <div class="pl"></div>
    <div class="bed">
      <h2 class="cv-h" id="elsewhere-title">Elsewhere</h2>
      <ul class="elsewhere-list">
        {elsewhere.map((e) => (
          <li class="elsewhere-item">
            <a class="elsewhere-thumb" href={e.url} aria-hidden="true" tabindex="-1">
              <span class="et-kind">{e.kind}</span>
              <span class="et-venue">TRAFO</span>
            </a>
            <div class="elsewhere-copy">
              <span class="elsewhere-meta">{e.kind} · {e.venue} · {e.date}</span>
              <h3 class="elsewhere-title"><a href={e.url}>{e.title}</a></h3>
              <span class="elsewhere-byline">{e.byline}</span>
              <p>{e.summary}</p>
              <p class="elsewhere-link"><a href={e.url}>Read on TRAFO →</a>{e.doi && <span class="elsewhere-doi"> · DOI <a href={`https://doi.org/${e.doi}`}>{e.doi}</a></span>}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div class="pr"></div>
  </section>}

  <section class="row blog-status" aria-labelledby="blog-status-title">
    <div class="pl"></div>
    <div class="bed">
      <p class="sc">Coming soon</p>
      <h2 id="blog-status-title" class="blog-status-title">Under<br class="status-break"> construction</h2>
      <p class="blog-status-note">The blog is still being set up. Posts and interviews will appear here as the project develops.</p>
    </div>
    <div class="pr"></div>
  </section>
</Base>

<style>
  .blog-intro {
    padding-top: var(--s-7);
    padding-bottom: var(--s-5);
  }
  .blog-kicker {
    margin-bottom: var(--s-2);
  }
  .blog-intro h1.title {
    margin-bottom: var(--s-2);
  }
  .blog-subtitle {
    max-width: 34em;
    margin: 0 0 var(--s-5);
  }
  .blog-platform {
    font-family: var(--f-note);
    font-size: var(--t-body-s);
    line-height: var(--lh-body-s);
    max-width: 44em;
    margin: 0;
    color: var(--c-muted);
  }
  .blog-platform a {
    color: var(--c-ink);
  }
  .blog-section {
    padding-top: var(--s-3);
    padding-bottom: var(--s-5);
  }
  .blog-section .cv-h {
    margin-bottom: var(--s-3);
  }
  .blog-section p {
    font-size: var(--t-body-s);
    line-height: 1.62;
    margin: 0 0 var(--s-4);
    max-width: 43em;
  }
  .blog-section p:last-child {
    margin-bottom: 0;
  }
  .blog-status {
    background: var(--c-cheia-1);
    padding-top: var(--s-7);
    padding-bottom: var(--s-8);
    margin-top: var(--s-3);
  }
  .blog-status-title {
    font-weight: 300;
    font-size: clamp(42px, 7vw, 86px);
    line-height: .96;
    letter-spacing: -.035em;
    margin: var(--s-3) 0 var(--s-4);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .blog-status-note {
    max-width: 35em;
    margin: 0;
    font-size: var(--t-body-s);
    line-height: var(--lh-body-s);
  }
  .elsewhere-list { list-style: none; margin: 0; padding: 0; }
  .elsewhere-item {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
    padding-top: var(--s-3);
    border-top: var(--b-hair);
  }
  .elsewhere-thumb {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--c-cheia-1);
    color: var(--c-ink);
    text-decoration: none;
  }
  .et-kind { font-family: var(--f-note); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  .et-venue { font-size: 34px; font-weight: 300; letter-spacing: -.02em; line-height: 1; }
  .elsewhere-meta, .elsewhere-byline { display: block; font-family: var(--f-note); font-size: 14.5px; color: var(--c-muted); }
  .elsewhere-title { font-size: 22px; font-weight: 400; line-height: 1.3; margin: 4px 0 2px; }
  .elsewhere-title a { color: var(--c-ink); }
  .blog-section .elsewhere-copy p { margin: var(--s-2) 0 0; }
  .blog-section .elsewhere-copy p.elsewhere-link { font-family: var(--f-note); font-size: var(--t-label); }
  .elsewhere-doi { color: var(--c-muted); }
  @media (max-width: 760px) {
    .elsewhere-item { grid-template-columns: 1fr; gap: var(--s-2); }
    .elsewhere-thumb { max-width: 160px; }
    .et-venue { font-size: 26px; }
    .blog-intro { padding-top: var(--s-6); }
    .blog-section { padding-bottom: var(--s-4); }
    .blog-status { padding-top: var(--s-6); padding-bottom: var(--s-6); }
    .blog-status-title { font-size: clamp(38px, 11vw, 64px); }
  }
</style>
