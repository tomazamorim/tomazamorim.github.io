---
// Verbete (DS v1.1 §6.9, rodada 4): faixa com o termo e os outros nomes (nível 3); definição; citações literais com fonte curta, página, tradutor e coautoria;
// publicações e falas relacionadas; "Near it" na margem; lista única de fontes com botão Copy; "About this entry" recolhido.
// Dois tipos: Keyword (tema) e Author (autor analisado). No público só existe depois de KW_APPROVED (Tomaz aprova as 16 entradas).
import Base from '../../../layouts/Base.astro';
import CopyButton from '../../../components/CopyButton.astro';
import KeywordIndex from '../../../components/KeywordIndex.astro';
import TalkItem from '../../../components/TalkItem.astro';
import { inline, visibleKeywords, absoluteUrl, activeMarks, markLabel, kwUrl, isPreview, hasResearch, site } from '../../../lib/data';
import { nestQuotes, nearOf, shortTitle, sourceRefs, pageLabel, langName, relatedPubs, relatedTalks, otherNames, isWeb } from '../../../lib/research';

export function getStaticPaths() {
  const list = visibleKeywords();
  if (!list.length || !hasResearch()) return []; // sem verbetes liberados (KW_APPROVED), ou sem lede da pesquisa no público: nem o índice existe
  return [{ params: { slug: undefined }, props: { k: null } }, ...list.map((k) => ({ params: { slug: k.slug }, props: { k } }))];
}
const k: any = Astro.props.k;
const isAuthor = k?.kind === 'author';
const others = k ? otherNames(k) : [];
const refs = k ? sourceRefs(k) : [];
const near = k ? nearOf(k) : [];
const rpubs = k ? relatedPubs(k) : [];
const rtalks = k ? relatedTalks(k) : [];
const url = k ? absoluteUrl(kwUrl(k.slug)) : '';
const kwAll = visibleKeywords();
// um nome que é, ele mesmo, o termo de outra entrada vira link
const entryOf = (text: string) => kwAll.find((o) => o.id !== k.id && o.term.toLowerCase() === text.toLowerCase());
const marks = k ? activeMarks([{ q: 'KW_APPROVED', note: 'definition, quotations and selection await Tomaz’s approval; the entry is hidden from the public build until then' }]) : [];
const jsonld = k && {
  '@context': 'https://schema.org', '@type': 'DefinedTerm', name: k.term, url,
  inDefinedTermSet: { '@type': 'DefinedTermSet', name: 'Keywords, Extractivism and Infrastructure in Brazilian Literature', url: absoluteUrl('/research/keywords/') },
};
const sigOf = (sig: string) => `s-${sig}`;
const trLabel = (q: any) => (q.translator ? `${langName(q.lang)} translation: ${q.translator}` : null);
---
{!k ? (
<Base title="Keywords" description="Keywords of the research project Extractivism and Infrastructure in Brazilian Literature." season="flood" nav="keywords" path="/research/keywords/">
  <KeywordIndex standalone={true} />
</Base>
) : (
<Base copy={true} title={`${k.term} · ${isAuthor ? 'Authors' : 'Keywords'}`} description={`${isAuthor ? 'Author' : 'Keyword'} entry: ${k.term}.`} season="flood" nav="keywords" path={kwUrl(k.slug)} jsonld={jsonld}>
  <section class="row highwater lv3 sp-m kw-head-row" aria-label="The term and its other names">
    <div class="bed kw-head">
      <p class="kw-kind">{isAuthor ? 'Author' : 'Keyword'}</p>
      <div class="kw-title">
        <h1 class="kw-term">{k.term}</h1>
      </div>
      {others.length > 0 && (
        <ul class="kw-others">
          {others.map((n) => {
            const e = entryOf(n.text);
            return <li><span class="lang">{n.lang}</span>{e ? <a href={kwUrl(e.slug)}><i lang={n.lang}>{n.text}</i></a> : <i lang={n.lang || undefined}>{n.text}</i>}</li>;
          })}
        </ul>
      )}
    </div>
  </section>
  <section class="row submerged lv3 sp-m kw-body">
    <div class="bed">
      {k.definition && <p class="kw-def" lang="en">{k.definition}</p>}
      {k.quotes.length > 0 && <div class="kw-quotes">
      <h2 class="kw-h">In the texts</h2>
      {k.quotes.map((q, i) => {
        const tr = trLabel(q);
        const pg = pageLabel(q.page);
        return (
          <blockquote class={`kw-q ${i > 0 ? 'second' : ''}`} lang={q.lang}>
            “{nestQuotes(q.text)}”
            <span class="qsrc" lang="en"><a href={`#${sigOf(q.source)}`}>{isWeb(q.source) ? 'Project 4' : shortTitle(q.source)}</a>{pg ? `, ${pg}` : ''}{tr && <Fragment> · {tr}</Fragment>}{q.coauthor && <Fragment> · co-authored with {q.coauthor}</Fragment>}{isPreview && q.ocr && <Fragment> <span class="tbc">[A CONFIRMAR: to be checked against the printed page · OCR]</span></Fragment>}</span>
          </blockquote>
        );
      })}
      </div>}
      {(rpubs.length > 0 || rtalks.length > 0) && <div class="kw-related">
      {rpubs.length > 0 && (
        <Fragment>
          <h2 class="kw-h">Related publications</h2>
          <ul class="kw-rel">
            {rpubs.map((p) => <li><span class="yr">{p.year}</span><span><a href={`/publications/#${p.id}`} lang={p.lang} set:html={p.html} />{p.credit && <span class="cr"> · <Fragment set:html={inline(p.credit, { marks: false })} /></span>}</span></li>)}
          </ul>
        </Fragment>
      )}
      {rtalks.length > 0 && (
        <Fragment>
          <h2 class="kw-h">Related talks</h2>
          <ul class="items kw-talks">{rtalks.map((g) => <TalkItem t={g.main} also={g.also} />)}</ul>
        </Fragment>
      )}
      </div>}
      {refs.length > 0 && (
        <ul class="sources">
          <li style="border-top:0;padding:0"><h2 class="nh">Sources</h2></li>
          {refs.map((r) => (
            <li id={sigOf(r.sig)}>
              <span><span set:html={r.html} />{r.pages ? ` Quoted: ${r.pages}.` : ''}{r.url && <Fragment>{' '}<a href={r.url}>{r.label}</a>.</Fragment>}</span>
              <CopyButton text={r.plain} label="Copy" />
            </li>
          ))}
        </ul>
      )}
      <p class="entry-acts"><CopyButton text={url} label="Copy link to this entry" /></p>
      {marks.length > 0 && <p class="entry-marks">{marks.map((m) => <Fragment><span class="tbc">{markLabel(m)}</span>{' '}</Fragment>)}</p>}
      <details class="about"><summary>About this entry</summary>
        <p>Quotations checked against the published texts: {site.sources_checked}. <a href="/colophon/#editorial-method">Editorial method</a>.</p>
        {others.length > 0 && <p>Where the other names occur: {others.map((n, i) => <Fragment>{i > 0 && '; '}<i lang={n.lang}>{n.text}</i> ({langName(n.lang)}) in <i>{shortTitle(n.source)}</i>{pageLabel(n.page) ? `, ${pageLabel(n.page)}` : ''}</Fragment>)}.</p>}
      </details>
    </div>
    <div class="pl note">
      {near.length > 0 && <h2 class="nh">Near it</h2>}
      {near.length > 0 && <p>{near.map((o, i) => <Fragment>{i > 0 && <br />}<a href={kwUrl(o.slug)}>{o.term}</a></Fragment>)}</p>}
    </div>
    <div class="pr note src-anchors">
      {refs.length > 0 && <h2 class="nh">Sources</h2>}
      {refs.length > 0 && <p>{refs.map((r, i) => <Fragment>{i > 0 && <br />}<a href={`#${sigOf(r.sig)}`}>{r.short}</a>{r.year ? `, ${r.year}` : ''}</Fragment>)}</p>}
    </div>
  </section>
  <section class="row lv0 sp-s">
    <div class="pl"></div>
    <div class="bed"><p class="back-link"><a href="/research/keywords/">← All keywords</a></p></div>
    <div class="pr"></div>
  </section>
</Base>
)}
