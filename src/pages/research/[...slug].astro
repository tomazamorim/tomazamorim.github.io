---
import Base from '../../layouts/Base.astro';
export function getStaticPaths() {
  return [{ params: { slug: undefined } }];
}
---
<Base title="Research" description="Research page under construction." season="flood" nav="project" path="/research/">
  <section class="row opening2 lv0" id="top">
    <div class="ttl">
      <span class="sc">Research</span>
      <h1>Extractivism and Infrastructure in Brazilian Literature</h1>
    </div>
    <div class="pr"></div>
  </section>
  <section class="row lv0 construction-row">
    <div class="pl"></div>
    <div class="bed">
      <p class="construction-notice">Still under construction.</p>
    </div>
    <div class="pr"></div>
  </section>
</Base>
