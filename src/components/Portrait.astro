---
import { getImage } from 'astro:assets';
import portrait from '../assets/tomaz-amorim-foto-ricson-onodera.jpg';
import { site } from '../lib/data';
interface Props { width?: number; credit?: 'short' | 'long'; class?: string }
const { width = 188, credit = 'short' } = Astro.props;
// Keep the established vertical cover crop while sourcing it from the newly supplied high-resolution photograph.
const aspect = 579 / 869;
const dens = [1, 2, 3].map((d) => width * d);
const variants = await Promise.all(dens.map((w) => getImage({
  src: portrait,
  width: w,
  height: Math.round(w / aspect),
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 78,
})));
const webp = await Promise.all(dens.map((w) => getImage({
  src: portrait,
  width: w,
  height: Math.round(w / aspect),
  fit: 'cover',
  position: 'center',
  format: 'webp',
  quality: 72,
})));
const h = Math.round(width / aspect);
const srcset = (list: any[]) => list.map((g) => `${g.src} ${g.options.width}w`).join(', ');
---
<figure class="portrait">
  <picture>
    <source type="image/webp" srcset={srcset(webp)} sizes={`${width}px`}>
    <img src={variants[0].src} srcset={srcset(variants)} sizes={`${width}px`} width={width} height={h} alt={site.portrait.alt} decoding="async">
  </picture>
  {credit === 'short' && <figcaption>Photo: {site.portrait.credit} · <a href={site.portrait.download}>High-resolution photograph</a></figcaption>}
</figure>
